# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# Database (for local migration tooling)
DATABASE_URL=postgresql://postgres:<password>@db.<project-id>.supabase.co:5432/postgres

# OpenRouter
OPENROUTER_API_KEY=<key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Nano Banana
NANO_BANANA_API_KEY=<key>

# SeeDance
SEEDANCE_API_KEY=<key>

# Telegram Bot
TELEGRAM_BOT_TOKEN=<token>

# iiko Cloud API
IIKO_API_LOGIN=<login>
IIKO_API_PASSWORD=<password>

# OpenWeatherMap / Open-Meteo (free, no key needed for Open-Meteo)
OPENWEATHER_API_KEY=<key>

# n8n
N8N_WEBHOOK_URL=https://n8n.<your-domain>.com
